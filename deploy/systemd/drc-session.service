[Unit]
Description=Dog Research Capital daily forward-test session (paper only), report and ledger backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=DRC_HOST=__HOST__
ExecStart=/bin/bash deploy/session-cycle.sh
TimeoutStartSec=1h
