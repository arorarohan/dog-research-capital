[Unit]
Description=Daily forward-test session for Dog Research Capital (12:00 UTC)

[Timer]
# The charter's [schedule] time_utc. The session logs how late it ran (late_secs).
OnCalendar=*-*-* 12:00:00 UTC
# If the VM was down at 12:00, run once at boot. A run on a LATER day logs the skipped days as
# session_missed (never backfilled). On the same day: up to the charter's max_late_secs (2 h)
# after 12:00 it is a normal session (window anchored to 12:00); later, today is logged as
# session_missed and the job exits 1. A boot run before 12:00 does nothing (exit 0).
Persistent=true

[Install]
WantedBy=timers.target
